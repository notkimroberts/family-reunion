{
    "name": "family-reunion",
    "version": "0.0.4",
    "type": "module",
    "scripts": {
        "dev": "bun run clean && NODE_TLS_REJECT_UNAUTHORIZED=0 vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "clean": "rm -rf .svelte-kit && rm -rf build && rm -rf node_modules/.vite",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "bun scripts/migrate.ts",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "db:seed": "bun src/lib/server/db/seed.ts",
        "db:reseed": "bun src/lib/server/db/seed.ts --reseed",
        "admin:create": "bun scripts/createAdmin.ts",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint .",
        "prepare": "husky",
        "release": "commit-and-tag-version",
        "release:minor": "commit-and-tag-version --release-as minor",
        "release:major": "commit-and-tag-version --release-as major",
        "release:first": "commit-and-tag-version --first-release",
        "start": "node build/index.js",
        "stripe:dev": "bun scripts/stripeListen.ts",
        "test": "vitest run",
        "sentry:code-mappings": "bunx @sentry/cli@^3 code-mappings upload ./sentry-mappings.json"
    },
    "devDependencies": {
        "@electric-sql/pglite": "^0.5.8",
        "@eslint/compat": "^2.1.0",
        "@eslint/js": "^10.0.1",
        "@faker-js/faker": "^10.6.0",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@internationalized/date": "^3.12.3",
        "@lucide/svelte": "^0.577.0",
        "@sveltejs/adapter-node": "^5.5.7",
        "@sveltejs/kit": "^2.70.3",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@types/debug": "^4.1.13",
        "@types/node": "^25.9.5",
        "bits-ui": "^2.19.0",
        "commit-and-tag-version": "^12.7.3",
        "drizzle-kit": "^0.31.10",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.23.0",
        "globals": "^17.11.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "lint-staged": "^17.4.1",
        "mode-watcher": "^1.1.0",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^3.5.2",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "svelte": "^5.57.0",
        "svelte-check": "^4.7.6",
        "svelte-sonner": "^1.2.1",
        "tailwind-merge": "^3.6.0",
        "tailwind-variants": "^3.3.1",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.68.0",
        "vite": "^8.2.2",
        "vitest": "4.1.6"
    },
    "dependencies": {
        "@sentry/sveltekit": "^10.72.0",
        "better-auth": "^1.7.2",
        "debug": "^4.4.3",
        "drizzle-orm": "^0.45.2",
        "formsnap": "^2.0.1",
        "marked": "^18.0.11",
        "postgres": "^3.4.9",
        "resend": "^6.25.0",
        "stripe": "^22.6.0",
        "sveltekit-superforms": "^2.30.2",
        "zod": "^4.5.4"
    },
    "lint-staged": {
        "*.{ts,js,svelte}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,css,md,html}": [
            "prettier --write"
        ]
    }
}

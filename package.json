{
    "name": "family-reunion",
    "version": "0.0.4",
    "type": "module",
    "scripts": {
        "dev": "bun run clean && NODE_TLS_REJECT_UNAUTHORIZED=0 vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "clean": "rm -rf .svelte-kit && rm -rf build && rm -rf node_modules/.vite",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "bun scripts/migrate.ts",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "db:seed": "bun src/lib/server/db/seed.ts",
        "db:reseed": "bun src/lib/server/db/seed.ts --reseed",
        "admin:create": "bun scripts/createAdmin.ts",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint .",
        "prepare": "husky",
        "release": "commit-and-tag-version",
        "release:minor": "commit-and-tag-version --release-as minor",
        "release:major": "commit-and-tag-version --release-as major",
        "release:first": "commit-and-tag-version --first-release",
        "start": "node build/index.js",
        "test": "vitest run",
        "sentry:code-mappings": "bunx @sentry/cli@^3 code-mappings upload ./sentry-mappings.json"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.0",
        "@eslint/js": "^10.0.1",
        "@faker-js/faker": "^10.4.0",
        "@internationalized/date": "^3.12.0",
        "@lucide/svelte": "^0.577.0",
        "@sveltejs/adapter-node": "^5.5.4",
        "@sveltejs/kit": "^2.60.1",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.3.0",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/debug": "^4.1.13",
        "@types/node": "^25.8.0",
        "bits-ui": "^2.18.1",
        "commit-and-tag-version": "^12.7.3",
        "drizzle-kit": "^0.31.10",
        "eslint": "^10.4.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.17.1",
        "globals": "^17.6.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "lint-staged": "^17.0.4",
        "mode-watcher": "^1.1.0",
        "prettier": "^3.8.3",
        "prettier-plugin-svelte": "^3.5.2",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "svelte": "^5.55.7",
        "svelte-check": "^4.4.8",
        "svelte-sonner": "^1.1.0",
        "tailwind-merge": "^3.6.0",
        "tailwind-variants": "^3.2.2",
        "tailwindcss": "^4.3.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.3",
        "vite": "^8.0.13",
        "vitest": "4.1.6"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1048.0",
        "@aws-sdk/s3-request-presigner": "^3.1048.0",
        "@sentry/sveltekit": "^10",
        "better-auth": "^1.6.11",
        "debug": "^4.4.3",
        "drizzle-orm": "^0.45.2",
        "formsnap": "^2.0.1",
        "marked": "^18.0.3",
        "postgres": "^3.4.9",
        "resend": "^6.22.1",
        "stripe": "^22.1.1",
        "sveltekit-superforms": "^2.30.1",
        "zod": "^4.4.3"
    },
    "lint-staged": {
        "*.{ts,js,svelte}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,css,md,html}": [
            "prettier --write"
        ]
    }
}

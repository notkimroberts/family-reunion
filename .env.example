# Database
DATABASE_URL=postgresql://localhost:5432/family_reunion

# Better Auth
# BETTER_AUTH_URL must equal the origin the site is served on, exactly — in production,
# https:// plus APP_DOMAIN. Better Auth answers /api/auth/* only for that origin, so a stale value
# breaks admin sign-in on every other host.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# adapter-node (production only)
# ORIGIN: leave unset on Railway, or set it to the same origin as BETTER_AUTH_URL. A stale value makes
# SvelteKit's CSRF check reject every form post with 403.
# BODY_SIZE_LIMIT: adapter-node defaults to 512K, which rejects the average phone photo on
# /photos/contribute. The dev server applies no limit, so this fails only in production.
# ORIGIN=
# BODY_SIZE_LIMIT=

# Stripe
# The secret key decides which MODE everything runs in, and the webhook secret must come from the
# endpoint in that SAME mode — the two are different values, and a test-mode signing secret against a
# live key makes every webhook fail signature verification. Payments then succeed while registrations
# sit at 'pending' and no confirmation email is ever sent.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=
# Signing secret for the Resend delivery webhook (resend.com/webhooks). Without it,
# /api/webhooks/resend returns 500 and bounces go unnoticed.
RESEND_WEBHOOK_SECRET=

# The one account allowed into event settings and event creation. Matched against the signed-in user's
# email, case- and whitespace-insensitively. Set it to the address you passed to `bun run admin:create`.
#
# Left UNSET this FAILS OPEN: every admin can reach them. That is deliberate — the degraded state is
# the old behaviour (admins only, never the public), whereas failing closed would let one forgotten
# variable lock you out of your own pricing. requireOwner reports the missing value to Sentry once per
# process so it cannot go unnoticed. See src/lib/server/auth/isOwner.ts.
#
# PUBLIC_STRIPE_PUBLISHABLE_KEY and ADMIN_EMAIL used to be listed here and are not: nothing reads
# either. Checkout is a server-side redirect, so no publishable key is needed in the browser, and the
# contact address is the CONTACT_EMAIL constant.
OWNER_EMAIL=

# Photo bucket (Railway, S3-compatible). On Railway these are reference variables to the
# family-reunion-photos service — see CLAUDE.md "Photos".
BUCKET_NAME=
BUCKET_ENDPOINT=
BUCKET_REGION=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=

# Sentry
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=development
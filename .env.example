# Database
DATABASE_URL=postgresql://localhost:5432/family_reunion

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend
RESEND_API_KEY=
# Signing secret for the Resend delivery webhook (resend.com/webhooks). Without it,
# /api/webhooks/resend returns 500 and bounces go unnoticed.
RESEND_WEBHOOK_SECRET=
ADMIN_EMAIL=

# The one account allowed into /admin/setup — event settings, tiers and prices, photos, storefront,
# admin accounts. Matched against the signed-in user's email, case- and whitespace-insensitively.
# Set it to the address you passed to `bun run admin:create`.
#
# Left UNSET this FAILS OPEN: every admin can reach Setup. That is deliberate — the degraded state is
# the old behaviour (admins only, never the public), whereas failing closed would let one forgotten
# variable lock you out of your own pricing. requireOwner reports the missing value to Sentry once per
# process so it cannot go unnoticed. See src/lib/server/auth/isOwner.ts.
OWNER_EMAIL=

# Sentry
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=development